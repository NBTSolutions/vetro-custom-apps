{
  "name": "vetro-custom-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"VITE_API_HOST=local npm run build -- --mode development --watch\" \"node scripts/serve.js\" ",
    "prebuild": "rm -rf dist build.zip",
    "build": "tsc && vite build --mode production",
    "postbuild": "cp package.json dist/ && npm run zip",
    "zip": "cd dist && zip -Djr ../build.zip * && cd ..",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "antd": "^6.5.3",
    "dayjs": "^1.11.21"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serve": "^14.2.6",
    "serve-handler": "^6.1.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}
