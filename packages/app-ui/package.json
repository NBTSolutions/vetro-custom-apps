{
  "name": "vetro-custom-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently \"VITE_API_HOST=local npm run build -- --mode development --watch\" \"node scripts/serve.js\" ",
    "build": "tsc && vite build --mode production",
    "postbuild": "cp package.json dist/ && npm run zip",
    "zip": "cd dist && zip -Djr ../build.zip * && cd .."
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.34.1",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serve": "^14.2.4",
    "serve-handler": "^6.1.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
